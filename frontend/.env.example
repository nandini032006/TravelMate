# TravelMate — Environment Variables
# Copy this file to .env for local development.
# .env is gitignored — never commit real keys.
# The app works fully without these keys; live traffic and weather are hidden gracefully.

# ── OpenRouteService (optional) ──────────────────────────────────────
# Enables realistic walking path geometry on the map.
# Get a free key: https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=

# ── TomTom Traffic API (optional) ────────────────────────────────────
# Enables live congestion data per route. Free tier at developer.tomtom.com
VITE_TOMTOM_KEY=

# ── OpenWeatherMap API (optional) ────────────────────────────────────
# Enables live weather conditions per route. Free tier at openweathermap.org
VITE_WEATHER_KEY=
