# Dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
frontend/dist/

# Android build artifacts (keep source, ignore compiled output)
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/build/
*.apk
*.aab
