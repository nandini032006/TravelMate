# Android signing keystore — keep private, never commit
*.jks
*.keystore

# Environment files — never commit real keys
.env
backend/.env
frontend/.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Claude Code local config — not app code
.claude/

# AI tool configs — not app code
CLAUDE.md
.specify/

# Stray empty files
frontend/cd
frontend/code
frontend/npm
frontend/npx
